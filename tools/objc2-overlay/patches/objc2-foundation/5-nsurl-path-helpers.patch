+            (b"foo", true),
+            (b"/Library/././.", true),
+            (b"/Library/..", true),
+            (b"/a//b", false),
+            (b"/a/./b/", false),
+            (b"/a b/%20c", false),
+            (b"/\x08", false),
+            (b"/cafe\xcc\x81", false),
+            (b"/", false),
+            (b"/", true),

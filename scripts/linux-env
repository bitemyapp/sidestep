# Sourced by linux-cargo and linux-run. Sets the image and the named volumes
# the container keeps the registry and build output in, and defines
# `in_container COMMAND...`. Each git worktree gets a target volume of its
# own, so builds in parallel worktrees don't overwrite each other's output.
repo=$(cd "$(dirname "$0")/.." && pwd)
image=${SIDESTEP_LINUX_IMAGE:-sidestep-linux:1.96-trixie-5}
target=sidestep-target
if [ "$(git -C "$repo" rev-parse --git-dir 2>/dev/null)" != "$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null)" ]; then
  target=sidestep-target-$(basename "$repo" | tr -c 'A-Za-z0-9_.\n-' '-')
fi
if ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build -q -t "$image" -f "$repo/scripts/linux.Dockerfile" "$repo/scripts" >&2
fi
# objc2's crates with the fixes from Sidestep's objc2 fork, which the
# workspace's [patch.crates-io] points at (tools/objc2-overlay). Built on the
# host, or in the container if the host has no cargo; a no-op when they are
# up to date. The container runs as root, so it then gives .objc2-overlay the
# checkout's owner, as it appears in the container (the user with rootful
# Docker on Linux; root, which maps back to the user, with rootless Docker).
if command -v cargo >/dev/null 2>&1; then
  cargo run --quiet --release --manifest-path "$repo/tools/objc2-overlay/Cargo.toml" -- --quiet >/dev/null
else
  docker run --rm -v "$repo":/work -w /work \
    -v sidestep-cargo-registry:/usr/local/cargo/registry \
    -v "$target":/target -e CARGO_TARGET_DIR=/target/objc2-overlay \
    "$image" sh -c 'cargo run --quiet --release --manifest-path tools/objc2-overlay/Cargo.toml -- --quiet >/dev/null &&
      { chown -R --reference=/work .objc2-overlay ||
        echo "linux-env: could not give .objc2-overlay the checkout'\''s owner" >&2; }'
fi

in_container() {
  # shellcheck disable=SC2086
  exec docker run --rm ${SIDESTEP_DOCKER_FLAGS:-} \
    -v "$repo":/work -w /work \
    -v sidestep-cargo-registry:/usr/local/cargo/registry \
    -v sidestep-cargo-git:/usr/local/cargo/git \
    -v "$target":/target -e CARGO_TARGET_DIR=/target \
    -e RUST_BACKTRACE="${RUST_BACKTRACE:-0}" \
    -e CARGO_BUILD_JOBS -e RUSTFLAGS \
    -e SCENARIO -e SLICE_QUIT_AFTER -e SHOT -e SHOT_AFTER -e SIZE \
    -e SCALE -e FLOATING -e THEN -e THEN_AFTER -e SIDESTEP_DECORATIONS -e SIDESTEP_THEME -e SIDESTEP_NO_FRACTIONAL_SCALE \
    -e SIDESTEP_APPEARANCE -e SIDESTEP_ACCENT -e GALLERY_PNG -e GALLERY_SCALE -e GALLERY_APPEARANCE -e GALLERY_QUIT_AFTER \
    -e SIDESTEP_BACKEND -e SIDESTEP_CONFORMANCE_WINDOWS -e EVENTS_QUIT_AFTER -e LAYERDEMO_QUIT_AFTER \
    -e SIDESTEP_TRACE_FRAMES -e SIDESTEP_SCROLLER_STYLE -e CONTAINERS_SCROLL -e CONTAINERS_PNG -e CONTAINERS_SCALE -e CONTAINERS_BENCH \
    "$image" "$@"
}

#!/bin/sh
# Run a command in the Linux container scripts/linux-cargo builds in, with
# the same target directory, e.g.
#   scripts/linux-run scripts/headless-wayland /target/debug/appkit-slice
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
image=${SIDESTEP_LINUX_IMAGE:-sidestep-linux:1.96-trixie}
if ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build -q -t "$image" -f "$repo/scripts/linux.Dockerfile" "$repo/scripts" >&2
fi
exec docker run --rm ${SIDESTEP_DOCKER_FLAGS:-} \
  -v "$repo":/work -w /work \
  -v sidestep-cargo-registry:/usr/local/cargo/registry \
  -v sidestep-cargo-git:/usr/local/cargo/git \
  -v sidestep-target:/target -e CARGO_TARGET_DIR=/target \
  -e RUST_BACKTRACE="${RUST_BACKTRACE:-0}" \
  -e SCENARIO -e SLICE_QUIT_AFTER -e SHOT -e SHOT_AFTER -e SIZE \
  "$image" "$@"
